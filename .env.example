# ─── FilmUp chatbot (server-side only — read by netlify/functions/chat.ts) ───
# Never prefix these with VITE_ — that would expose them to the browser bundle.

# Which provider to use: anthropic | openai | gemini
AI_PROVIDER=anthropic

# Your provider's secret API key
AI_API_KEY=your-secret-key-here

# Optional: override the default model for the chosen provider
#   anthropic default: claude-haiku-5-5
#   openai default:    gpt-4.1-mini
#   gemini default:    gemini-2.5-flash
# AI_MODEL=
